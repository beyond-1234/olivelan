<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>org.olivelan.Olivelan</id>
  <name>Olivelan</name>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Olivelan Contributors</developer_name>
  <summary>Modern, high-performance GPU-resident non-linear video editor</summary>
  <summary xml:lang="zh_CN">现代化、高性能 GPU 驻留非线性视频编辑器</summary>
  <description>
    <p>
      Olivelan is a modern, high-performance, GPU-resident cross-platform non-linear video editor.
      Featuring a single-source OpenColorIO (OCIO) 2.5 color pipeline, multi-vendor zero-copy hardware
      decoding, and a sleek Metro/Fluent design system.
    </p>
    <p xml:lang="zh_CN">
      Olivelan 是一款现代化、高性能、GPU 驻留直通的跨平台开源非线性视频编辑软件。
      拥有 OpenColorIO 2.5 现代单轨色彩管线、多厂商硬件零拷贝直通架构以及现代 Metro/Fluent 声明式工作区设计。
    </p>
  </description>
  <url type="homepage">https://github.com/beyond-1234/olivelan</url>
  <url type="bugtracker">https://github.com/beyond-1234/olivelan/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@APPDATA_RELEASE_VERSION@" date="@APPDATA_RELEASE_DATE@"/>
  </releases>
</component>
